# Реалистичный: VPS на 2 ядра и 4 ГБ, мобильный интернет, обычный провайдер, пики ×10,
# посередине перезапускается воркер СМС.
TOTAL_VOTES=100000
PEAK_X=10
SPIKE_FRAC=0.02
RAMP_FRAC=0.01

# Ресурсы сервера: SERVER_CPUS ядер на всё (API, база, Redis, воркер, nginx), как на VPS.
SERVER_CPUS=2
API_REPLICAS=2
API_MEM=384m
DB_MEM=1g
DB_POOL=10

NET_DELAY_MS=80
NET_JITTER_MS=20
NET_LOSS_PCT=1

SMS_RATE=100
SMS_ERROR_RATE=0.05
SMS_API_LATENCY_MS=100-500
SMS_DELIVERY_MS=3000-15000
SMS_OUTAGE_AT=0
SMS_OUTAGE_SEC=0

SMS_PATIENCE_SEC=180
DOUBLE_VOTE_SHARE=0.01
VIEWERS_PER_SEC=10
BRUTEFORCE_PER_MIN=3
SPAM_PER_MIN=3

CHAOS=worker@0.5

SUCCESS_MIN=0.98
API_P95_MS=800
SMS_WAIT_P95_SEC=120

MAX_VUS=4000
