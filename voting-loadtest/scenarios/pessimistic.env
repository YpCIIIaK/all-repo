# Пессимистичный: VPS вдвое слабее реалистичного (1 ядро на всё), плохая сеть, пики ×20,
# провайдер с ошибками и пятиминутным сбоем, перезапуски воркера и базы прямо на пиках.
TOTAL_VOTES=100000
PEAK_X=20
SPIKE_FRAC=0.01
RAMP_FRAC=0.005

# Ресурсы сервера: SERVER_CPUS ядер на всё (API, база, Redis, воркер, nginx), как на VPS.
SERVER_CPUS=1
API_REPLICAS=2
API_MEM=384m
DB_MEM=1g
DB_POOL=10

NET_DELAY_MS=200
NET_JITTER_MS=100
NET_LOSS_PCT=3

SMS_RATE=200
SMS_ERROR_RATE=0.10
SMS_API_LATENCY_MS=200-1500
SMS_DELIVERY_MS=5000-30000
SMS_OUTAGE_AT=0.3
SMS_OUTAGE_SEC=300

SMS_PATIENCE_SEC=180
DOUBLE_VOTE_SHARE=0.02
VIEWERS_PER_SEC=20
BRUTEFORCE_PER_MIN=5
SPAM_PER_MIN=5

CHAOS=worker@0.2,db@0.97

SUCCESS_MIN=0.95
API_P95_MS=2000
SMS_WAIT_P95_SEC=300

# k6: максимум одновременно ждущих пользователей (виртуальных пользователей)
MAX_VUS=8000
