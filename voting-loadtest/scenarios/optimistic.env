# Оптимистичный: VPS на 4 ядра, хорошая сеть, надёжный провайдер, пики ×5.
TOTAL_VOTES=100000
PEAK_X=5
SPIKE_FRAC=0.04
RAMP_FRAC=0.01

# Ресурсы сервера: SERVER_CPUS ядер на всё (API, база, Redis, воркер, nginx), как на VPS.
SERVER_CPUS=4
API_REPLICAS=3
API_MEM=512m
DB_MEM=1g
DB_POOL=10

NET_DELAY_MS=20
NET_JITTER_MS=5
NET_LOSS_PCT=0

# СМС-провайдер
SMS_RATE=100
SMS_ERROR_RATE=0.01
SMS_API_LATENCY_MS=50-200
SMS_DELIVERY_MS=2000-6000
SMS_OUTAGE_AT=0
SMS_OUTAGE_SEC=0

# Поведение людей и атаки
SMS_PATIENCE_SEC=180
DOUBLE_VOTE_SHARE=0.01
VIEWERS_PER_SEC=5
BRUTEFORCE_PER_MIN=2
SPAM_PER_MIN=2

# Сбои во время теста: служба@доля длительности, через запятую
CHAOS=

# Пороги прохождения
SUCCESS_MIN=0.99
API_P95_MS=500
SMS_WAIT_P95_SEC=60

MAX_VUS=4000
