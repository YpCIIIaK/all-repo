    "@nestjs/graphql": "^12.2.2",
    "@nestjs/platform-express": "^10.4.22",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.0.0",
    "graphql": "^16.14.2",
    "ioredis": "^5.11.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
